{
  "app": "npx ts-node --prefer-ts-exts bin/mojacoder-backend.ts",
  "context": {
    "@aws-cdk/core:enableStackNameDuplicates": "true",
    "aws-cdk:enableDiffNoFail": "true",
    "@aws-cdk/core:stackRelativeExports": "true",
    "appsyncWafRateLimit": 300,
    "appsyncWafRateLimitAction": "count",
    "appsyncWafIpReputationAction": "count"
  }
}
